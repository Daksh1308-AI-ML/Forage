{
  "title": "Forge AGI - System Dashboard",
  "uid": "forge-agi-dashboard",
  "version": 1,
  "schemaVersion": 27,
  "tags": ["forge-agi", "ai", "monitoring"],
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "System Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=\"forge-agi\"}",
          "legendFormat": "Status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "Memory Usage",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "forge_memory_usage_bytes / 1024 / 1024",
          "legendFormat": "Memory (MB)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MB",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "title": "Active Workers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "forge_active_workers",
          "legendFormat": "Workers"
        }
      ]
    },
    {
      "title": "DB Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "forge_db_connections",
          "legendFormat": "Connections"
        }
      ]
    },
    {
      "title": "Task Creation Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(forge_tasks_total{status=\"created\"}[5m])",
          "legendFormat": "Created"
        },
        {
          "expr": "rate(forge_tasks_total{status=\"completed\"}[5m])",
          "legendFormat": "Completed"
        },
        {
          "expr": "rate(forge_tasks_total{status=\"failed\"}[5m])",
          "legendFormat": "Failed"
        }
      ]
    },
    {
      "title": "Request Duration (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(forge_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Total Tasks by Status",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "forge_tasks_total",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Request Duration Heatmap",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "expr": "rate(forge_request_duration_seconds_bucket[5m])",
          "legendFormat": "le {{le}}"
        }
      ]
    }
  ],
  "rows": [],
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "description": "Pre-configured dashboard for Forge AGI monitoring with Prometheus"
}
